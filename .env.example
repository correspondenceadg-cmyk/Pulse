# Copy to .env for local dev.

# In production these are set as environment variables on the host.

APP_ENV=development
PORT=8080

# Postgres. pgx wants the standard URL form, not JDBC.
# Production example (Aiven free tier):
#   postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require
DATABASE_URL=postgres://user:password@localhost:5432/pulse?sslmode=disable

# Generate with: openssl rand -base64 48
# Must be at least 32 bytes.
JWT_SECRET=replace-me-with-at-least-32-bytes-of-random

LOG_LEVEL=info